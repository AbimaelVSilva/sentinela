# ---------- Infra (docker-compose) ----------
POSTGRES_USER=sentinela
POSTGRES_PASSWORD=sentinela
POSTGRES_DB=sentinela
# IPs/hosts anunciados pelo WebRTC do MediaMTX (IP do host na LAN, separados por vírgula)
MEDIAMTX_WEBRTC_HOSTS=127.0.0.1

# ---------- API ----------
DATABASE_URL=postgres://sentinela:sentinela@localhost:5432/sentinela
API_PORT=3333
# URL RTMP pública (túnel TCP / VPS). Nunca localhost para câmera real.
PUBLIC_RTMP_URL=rtmp://SEU_HOST_PUBLICO:1935
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_HLS_URL=http://localhost:8888
STORAGE_DIR=./storage
YOLO_MODEL_PATH=./models/yolo.onnx
# Opcional: URL direta de um .onnx já exportado (senão `npm run model:download` exporta via Docker)
YOLO_ONNX_URL=
# Provider/modelo iniciais — depois podem ser trocados no painel (botão Configurações).
# anthropic | openai | google | mock (mock = análise simulada, sem custo, só para desenvolvimento)
VISION_PROVIDER=anthropic
# Anthropic (VISION_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5
# OpenAI (VISION_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
# Opcional: endpoint compatível (ex.: Azure OpenAI / proxy)
OPENAI_BASE_URL=
# Google Gemini (VISION_PROVIDER=google)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-latest
# Opcional: preço (USD por milhão de tokens) para a estimativa de custo no log
VISION_PRICE_INPUT_PER_MTOK=
VISION_PRICE_OUTPUT_PER_MTOK=
# Esforço de raciocínio do modelo: low | medium | high
VISION_EFFORT=medium
# Refaz o INVENTORY sobre o baseline a cada N eventos
INVENTORY_REFRESH_EVERY=20
# Parâmetros da máquina de estados (ver docs/PROMPT.md, seção 8)
ANALYSIS_FPS=4
PERSON_CONFIDENCE=0.45
ROI_OVERLAP_MIN=0.15
ENTER_CONSECUTIVE_FRAMES=3
CLEAR_SECONDS=2.5
STABLE_SECONDS=1.5
STABLE_DIFF_MAX=0.01
SCENE_DIFF_MIN=0.004
MAX_OCCLUSION_SECONDS=600
# Se a cena não estabilizar, captura o "depois" mesmo assim após N segundos
STABLE_MAX_WAIT_SECONDS=15

# Usuário inicial criado pelo seed (npm run db:seed). Padrão: dev / 2306
SEED_USERNAME=
SEED_PASSWORD=
