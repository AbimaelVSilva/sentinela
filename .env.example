# ---------- Infra (docker-compose) ----------
POSTGRES_USER=sentinela
POSTGRES_PASSWORD=sentinela
POSTGRES_DB=sentinela
# IPs/hosts anunciados pelo WebRTC do MediaMTX (IP do host na LAN, separados por vírgula)
MEDIAMTX_WEBRTC_HOSTS=127.0.0.1

# ---------- API ----------
DATABASE_URL=postgres://sentinela:sentinela@localhost:5432/sentinela
API_PORT=3333
# URL RTMP pública (túnel TCP / VPS). Nunca localhost para câmera real.
PUBLIC_RTMP_URL=rtmp://SEU_HOST_PUBLICO:1935
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_HLS_URL=http://localhost:8888
STORAGE_DIR=./storage
YOLO_MODEL_PATH=./models/yolo.onnx
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5
# Parâmetros da máquina de estados (ver docs/PROMPT.md, seção 8)
ANALYSIS_FPS=4
PERSON_CONFIDENCE=0.45
ROI_OVERLAP_MIN=0.15
ENTER_CONSECUTIVE_FRAMES=3
CLEAR_SECONDS=2.5
STABLE_SECONDS=1.5
STABLE_DIFF_MAX=0.01
SCENE_DIFF_MIN=0.004
MAX_OCCLUSION_SECONDS=600
