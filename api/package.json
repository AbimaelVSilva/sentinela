{
  "name": "@sentinela/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "start": "node --env-file=../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "model:download": "tsx --env-file=../.env scripts/download-model.ts",
    "video:make": "tsx scripts/make-test-video.ts",
    "db:seed": "tsx --env-file=../.env src/db/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.6",
    "@google/genai": "^2.30.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "onnxruntime-node": "^1.30.0",
    "openai": "^7.35.0",
    "pino-pretty": "^13.2.0",
    "pixelmatch": "^8.0.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
