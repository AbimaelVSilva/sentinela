# deploy/.env no servidor (não versionado)
PUBLIC_HOST=77.42.24.7
PUBLIC_BASE_URL=http://77.42.24.7:8182
POSTGRES_PASSWORD=troque-esta-senha
# Provider inicial (depois troque pelo painel). mock = simulada; cada IA exige sua chave
VISION_PROVIDER=mock
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-latest
# Chave da câmera usada pelo simulador (profile "sim")
SIM_STREAM_KEY=

# Usuário inicial criado pelo seed (npm run db:seed). Padrão: dev / 2306
SEED_USERNAME=
SEED_PASSWORD=

# Vídeo curto de cada evento (recortado das gravações do MediaMTX)
CLIP_ENABLED=true
CLIP_PRE_SECONDS=3
CLIP_POST_SECONDS=2
CLIP_MAX_SECONDS=60
